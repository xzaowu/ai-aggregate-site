# App
# development | production
NODE_ENV=development
# Public web URL. Use your production web origin when deployed.
APP_URL=http://localhost:3000
# Trusted origin used only when building email verification links.
PUBLIC_WEB_URL=http://localhost:3000
# Optional browser-facing public app URL.
NEXT_PUBLIC_APP_URL=
# Optional browser-facing contact email shown on the contact page.
NEXT_PUBLIC_CONTACT_EMAIL=
# Browser-facing API URL used by the Next.js app.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# API
API_HOST=0.0.0.0
API_PORT=4000
# Development default allows localhost:3000 and localhost:3001.
# Production reads this comma-separated list. Do not use * in production.
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
# Use a strong random string in production, for example 32+ bytes from a password manager or openssl rand -base64 48.
JWT_SECRET=replace-with-a-strong-random-string
# Anonymous guest chat calls per IP per UTC day.
GUEST_DAILY_LIMIT=10

# Email verification SMTP is optional for initial startup. Leave this block
# commented to disable mail, or set the complete block before enabling normal
# registration/email-verification flows. SMTP_USER and SMTP_PASS must be set
# together when SMTP authentication is required.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_FROM_NAME=AI Aggregate
# SMTP_FROM_ADDRESS=no-reply@example.test
# SMTP_USER=
# SMTP_PASS=

# Database
DATABASE_URL=mysql://user:password@localhost:3306/ai_aggregate_site

# AI Provider
# Keep API keys on the backend only. Never expose them with NEXT_PUBLIC_*.
AI_BASE_URL=https://your-ai-gateway.example.com/v1
AI_API_KEY=replace-with-your-ai-provider-key
DEFAULT_MODEL=openai/gpt-oss-120b:free

# Platform-funded Title Cover Visual Brief bootstrap/fallback values. Admin
# SiteSetting values take precedence and apply without an API restart. These
# environment values are used only when the corresponding database
# configuration is absent; invalid or missing effective values fail closed.
# The model ID must resolve to an enabled registered chat model with an enabled route.
TITLE_COVER_BRIEF_MODEL_ID=
TITLE_COVER_BRIEF_COST_CREDITS=
TITLE_COVER_BRIEF_DAILY_BUDGET_CREDITS=

# Image prompt/output moderation is disabled by default. In enforce mode,
# Admin-configured routes referencing provider accounts are preferred.
IMAGE_MODERATION_MODE=off
# Legacy migration fallback only when no persisted imageModerationSettings row
# exists. These values are not used once backend moderation settings exist.
IMAGE_MODERATION_API_KEY=
IMAGE_MODERATION_BASE_URL=https://api.openai.com/v1
IMAGE_MODERATION_MODEL=omni-moderation-latest
IMAGE_MODERATION_TIMEOUT_MS=3000

# Comma-separated list of hostnames the API is allowed to download remote
# image URLs from (returned by AI image providers). Each downloaded image is
# validated, downloaded through a DNS-pinned secure fetcher, and stored as a
# private LOCAL StorageObject.  Leave empty if you do not need remote image
# download (Chat-format data URL images still work normally).
#
# Format: exact hostname (cdn.example.com) or single-label wildcard
# (*.example.com).  Do NOT use bare * or ALL, scheme, URL, path, query, port,
# IP address, or credential.  Only HTTPS on port 443 is allowed.
#
# When empty:
#   - API starts normally.
#   - Chat-format data URL images work normally.
#   - Chat-format remote URL and Native remote URL image generation fail.
#   - User credits are refunded; global budget is NOT refunded.
#
# Example (uses reserved example domains only):
# GENERATED_ASSET_DOWNLOAD_ALLOWED_HOSTS=cdn.example.com,*.images.example.com
GENERATED_ASSET_DOWNLOAD_ALLOWED_HOSTS=

# Storage cleanup is disabled by default.
# When enabled, periodically removes unreferenced LOCAL/GENERATED objects
# through the audited READY -> DELETED -> file removal -> row purge flow.
STORAGE_CLEANUP_ENABLED=0

# Milliseconds between cleanup cycles.
# Valid range: 1000-86400000. Default: 300000.
STORAGE_CLEANUP_INTERVAL_MS=300000

# Minimum time since StorageObject.updatedAt before a READY orphan is eligible.
# Must be a non-negative safe integer. Default: 3600000.
STORAGE_CLEANUP_READY_GRACE_MS=3600000

# Maximum READY and DELETED candidates processed in one combined cycle.
# Valid range: 1-100. Default: 10.
STORAGE_CLEANUP_BATCH_SIZE=10

# Multi-instance correctness relies on database row locks and CAS; Redis is not required.
# Restart the API after changing storage cleanup configuration.

# EPay (易支付)
# Set EPAY_ENABLED=true and fill all required URLs/PID/key to enable payment.
# After deployment, prefer managing these settings through the admin UI.
# Admin Payment Settings stored in the database take priority over these env vars.
EPAY_ENABLED=false
EPAY_GATEWAY_URL=
EPAY_PID=
EPAY_KEY=
EPAY_NOTIFY_URL=
EPAY_RETURN_URL=

# Payment Settings
# Required to save the merchant key from the admin payment settings UI.
# Use a strong random string (32+ bytes). Changing this after saving a key
# will make the encrypted key undecryptable.
PAYMENT_SETTINGS_SECRET=

# Setup Wizard
# Optional token to protect the first-run setup wizard.
# Recommended for public deployments. Leave empty to allow open setup access.
SETUP_TOKEN=

# Seed
# Leave either value empty to skip admin creation during prisma:seed.
# Use a strong password in production.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
