# Generic Docker deployment example. Copy to .env and replace placeholders.

NODE_ENV=production
APP_URL=https://your-domain.example
PUBLIC_WEB_URL=https://your-domain.example
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_CONTACT_EMAIL=

API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGINS=https://your-domain.example
JWT_SECRET=replace-with-a-strong-random-string
GUEST_DAILY_LIMIT=10

# Production rate limiting and concurrency use Redis. Redis is managed
# separately from this generic Compose file.
RATE_LIMIT_BACKEND=redis
REDIS_URL=redis://host.docker.internal:6379
REDIS_KEY_PREFIX=aiagg
REDIS_CONNECT_TIMEOUT_MS=5000

# SMTP is optional for initial startup. Leave this block commented to disable
# mail, or set the complete block before enabling normal registration/email-
# verification flows. SMTP_USER and SMTP_PASS must be set together when SMTP
# authentication is required.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_FROM_NAME=AI Aggregate
# SMTP_FROM_ADDRESS=no-reply@example.test
# SMTP_USER=
# SMTP_PASS=

# Use the database host/service name appropriate to your deployment.
DATABASE_URL=mysql://user:password@host.docker.internal:3306/ai_aggregate_site

# Self-configured Provider endpoint and credential; keep the credential private.
AI_BASE_URL=https://api.example.com/v1
AI_API_KEY=
DEFAULT_MODEL=

# Remote Provider image downloads are disabled unless explicitly allowlisted.
GENERATED_ASSET_DOWNLOAD_ALLOWED_HOSTS=

IMAGE_RECOVERY_ENABLED=0
EPAY_ENABLED=false
EPAY_GATEWAY_URL=
EPAY_PID=
EPAY_KEY=
EPAY_NOTIFY_URL=
EPAY_RETURN_URL=
PAYMENT_SETTINGS_SECRET=
SETUP_TOKEN=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
